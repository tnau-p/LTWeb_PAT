@{
    ViewData["Title"] = "Index";
    var accounts = ViewBag.accounts;

}
<div class="row">
    @foreach (var item in accounts)
    {
        <div class="col-md-4">
            <div class="img-thumbnail">
                <img src="@item.Avatar" alt="@item.Name" />
                <div class="caption">
                    <h3>@item.Name</h3>
                    <p>This is a simple caption for the avatar image.</p>
                    <p><a asp-route="profile" asp-route-id="@item.Id" class="btn btn-primary">Profile</a></p>
                </div>
            </div>
        </div>
    }
</div>
