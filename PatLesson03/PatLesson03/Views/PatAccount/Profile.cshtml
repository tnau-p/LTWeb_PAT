@{
    ViewData["Title"] = "Profile";
    var account = ViewBag.account;
}
<h2> Your Profile </h2>
<div class="row">
    <div class="col-md-4">
    <img src="@account.Avatar " alt="@account.Name" style="width: 100%" />
    </div>
    <div class="col-md-8">
        
        <h3>@account.Name</h3>
        <p>@account.Email</p>
        <p>@account.Phone</p>
        <p>@account.Address</p>
        <h3>Gender:
            @if (account.Gender == 1)
            {
                <span>Male</span>
            }
            else
            {
                <span>Female</span>
            }
        </h3>
        <h3> Date of Birth: @account.DateOfBirth.ToString("MM/dd/yyyy") </h3>
        <p>
            <a asp-controller="PatAccount" asp-action="Index" class="btn btn-primary">Back to List</a>
        </p>
    </div>
</div>