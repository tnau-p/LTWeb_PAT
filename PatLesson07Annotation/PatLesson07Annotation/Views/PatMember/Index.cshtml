@model IEnumerable<PatLesson07Annotation.Models.PatMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PatUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PatPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PatEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PatPhone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Id)
            </td>
            <td>
                @Html.DisplayFor(model => item.PatUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.PatPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.PatEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.PatPhone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
