using System;
using System.Collections.Generic;
using System.Text;

namespace PatLesson01
{
    public class MenuManager
    {
        private StudentService service = new StudentService();

        public void Run()
        {
            string choice;
            do
            {
                ShowMenu();
                Console.Write("Bạn chọn chức năng: ");
                choice = Console.ReadLine();

                switch (choice)
                {
                    case "1":
                        var s = StudentConsoleView.InputStudent(service);
                        service.AddStudent(s);
                        Console.WriteLine("Thêm thành công!");
                        break;
                    case "2":
                        StudentConsoleView.DisplayList(service.GetAll());
                        break;
                    case "3":
                        Console.Write("Nhập mã: ");
                        var st = service.FindById(Console.ReadLine());
                        if (st != null) StudentConsoleView.DisplayList(new List<Student> { st });
                        else Console.WriteLine("Không tìm thấy!");
                        break;
                    case "6":
                        Console.Write("Nhập mã cần xóa: ");
                        if (service.DeleteStudent(Console.ReadLine())) Console.WriteLine("Đã xóa!");
                        else Console.WriteLine("Không tìm thấy sinh viên để xóa!");
                        break;
                    case "14":
                        Console.WriteLine("Kết thúc chương trình.");
                        break;
                }
            } while (choice != "14");
        }

        private void ShowMenu()
        {
            Console.WriteLine("\n=========== CHỨC NĂNG ===========");
            Console.WriteLine("1. Thêm sinh viên");
            Console.WriteLine("2. Hiển thị danh sách");
            Console.WriteLine("3. Tìm sinh viên theo mã");
            Console.WriteLine("6. Xóa sinh viên");
            Console.WriteLine("14. Thoát");
        }
    }
}