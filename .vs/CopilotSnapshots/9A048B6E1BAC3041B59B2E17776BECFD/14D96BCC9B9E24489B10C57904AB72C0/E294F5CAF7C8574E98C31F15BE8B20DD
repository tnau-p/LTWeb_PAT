@model IEnumerable<PatLesson02MVC.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<h2 class="mb-4">Quản lý sản phẩm</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th style="width:50px">ID</th>
            <th>Name</th>
            <th style="width:160px">Price</th>
            <th style="width:130px">Created At</th>
            <th style="width:100px">Image</th>
            <th style="width:120px">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@String.Format("{0:N0} đ", item.Price)</td>
            <td>@item.CreatedAt.ToString("dd-MM-yyyy")</td>
            <td>
                <img src="@item.ImageUrl" alt="@item.Name" style="max-height:60px;" />
            </td>
            <td>
                <a class="btn btn-success" asp-action="Details" asp-route-id="@item.Id">View</a>
            </td>
        </tr>
    }
    </tbody>
</table>
