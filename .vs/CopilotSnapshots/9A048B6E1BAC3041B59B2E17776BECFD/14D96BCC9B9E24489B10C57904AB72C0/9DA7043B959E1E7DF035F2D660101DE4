using Microsoft.AspNetCore.Mvc;
using PatLesson02MVC.Models;
using System;
using System.Collections.Generic;
using System.Linq;

namespace PatLesson02MVC.Controllers
{
    public class ProductController : Controller
    {
        private static readonly List<Product> _products = new List<Product>
        {
            new Product { Id = 1, Name = "Product 1", Price = 500000, CreatedAt = new DateTime(2020,12,25), ImageUrl = "https://via.placeholder.com/150?text=Product+1" },
            new Product { Id = 2, Name = "Product 2", Price = 700000, CreatedAt = new DateTime(2020,12,25), ImageUrl = "https://via.placeholder.com/150?text=Product+2" },
            new Product { Id = 3, Name = "Product 3", Price = 550000, CreatedAt = new DateTime(2020,12,25), ImageUrl = "https://via.placeholder.com/150?text=Product+3" },
            new Product { Id = 4, Name = "Product 4", Price = 550000, CreatedAt = new DateTime(2020,12,25), ImageUrl = "https://via.placeholder.com/150?text=Product+4" }
        };

        public IActionResult Index()
        {
            return View(_products);
        }

        public IActionResult Details(int id)
        {
            var product = _products.FirstOrDefault(p => p.Id == id);
            if (product == null) return NotFound();
            return View(product);
        }
    }
}
